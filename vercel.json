{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rootstudy.co.kr"
        }
      ],
      "destination": "https://routestudy.co.kr/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.rootstudy.co.kr"
        }
      ],
      "destination": "https://routestudy.co.kr/",
      "statusCode": 301
    },
    {
      "source": "/:path((?!api/payments|api/cron).*)",
      "has": [
        {
          "type": "host",
          "value": "rootstudy.co.kr"
        }
      ],
      "destination": "https://app.routestudy.co.kr/:path",
      "statusCode": 301
    },
    {
      "source": "/:path((?!api/payments|api/cron).*)",
      "has": [
        {
          "type": "host",
          "value": "www.rootstudy.co.kr"
        }
      ],
      "destination": "https://app.routestudy.co.kr/:path",
      "statusCode": 301
    }
  ],
  "crons": [
    {
      "path": "/api/cron/caps-sync",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/weekly-points",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron/daily-reset",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/daily-focus-notify",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/quarterly-reset",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/mentoring-reward",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/vocab-exam-reminder",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/push-receipts",
      "schedule": "*/30 * * * *"
    }
  ]
}
